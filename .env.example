# ---------------------------------------------------------------------------
# JellyBean environment template
#
# Copy to .env and fill in. Never commit a populated .env — it is gitignored.
#
# Only VITE_-prefixed variables are inlined into the browser bundle. Anything
# secret MUST stay out of a VITE_ variable or it will ship to every client.
# ---------------------------------------------------------------------------

# --- Server-only ------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. Server use only.
# Never expose it to the browser under any circumstances.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy alias accepted for the service-role key (client.server.ts:12).
# Leave empty unless your platform only provides the short name.
SERVICE_ROLE_KEY=

# --- Browser-exposed --------------------------------------------------------
# Safe to ship to the client. The app also falls back to a committed default
# URL + anon key, so set these explicitly when you fork the project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy alias for the publishable key (client.ts:23).
VITE_SUPABASE_ANON_KEY=

# Declared for parity with the Supabase dashboard. Not currently read by src/.
VITE_SUPABASE_PROJECT_ID=

# --- Nextdoor ingest webhook ------------------------------------------------
# Shared secret required by the Chrome extension in production. The endpoint
# fails closed when neither variable is set. Prefer the explicit name.
NEXTDOOR_WEBHOOK_SECRET=
WEBHOOK_SECRET=

# --- AI ---------------------------------------------------------------------
# Server-only key for Raw Leads classification. For CS composition, configure
# OPENAI_API_KEY in Supabase Edge Function secrets instead; no local key needed.
OPENAI_API_KEY=

# Classification remains gpt-5.4-nano-2026-03-17. CS composition is pinned to
# gpt-5.4-2026-03-05 in supabase/functions/_shared/cs-composer.ts, with a separate
# review pass. OPENAI_MODEL/OPENAI_COMPOSE_MODEL never silently override it.

# --- Google Sheets ----------------------------------------------------------
# Optional override for the Apps Script webhook URL. If empty, the compiled-in
# default in src/lib/google-sheets-sync.ts is used.
VITE_GOOGLE_SHEETS_WEBHOOK_URL=

# --- Crisp ------------------------------------------------------------------
# Do NOT add per-site CRISP_* variables.
# Crisp workspace Website Tokens are managed through the JellyBean admin UI,
# stored individually in Supabase Vault, and linked via the crisp_workspaces
# table. See docs/architecture.md.
