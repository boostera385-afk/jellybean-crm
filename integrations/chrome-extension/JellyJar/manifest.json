{
  "manifest_version": 3,
  "name": "JellyJar",
  "version": "7.2.6",
  "description": "JellyBean's focused Nextdoor lead capture companion.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.nextdoor.com/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup-ui.html",
    "default_title": "JellyJar",
    "default_icon": {
      "16": "jellyjar-icon-16.png",
      "32": "jellyjar-icon-32.png",
      "48": "jellyjar-icon-48.png",
      "128": "jellyjar-icon-128.png"
    }
  },
  "icons": {
    "16": "jellyjar-icon-16.png",
    "32": "jellyjar-icon-32.png",
    "48": "jellyjar-icon-48.png",
    "128": "jellyjar-icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.nextdoor.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page_hook.js"],
      "matches": ["https://*.nextdoor.com/*"]
    }
  ]
}
